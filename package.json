{
  "name": "golf-signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Golf Radar: a local golf equipment and industry research prototype",
  "license": "MIT",
  "engines": { "node": ">=24.11" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "node --use-env-proxy --env-file-if-exists=.env scripts/serve.mjs",
    "pretest": "npm run build",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": { "fast-xml-parser": "5.11.1" },
  "devDependencies": { "esbuild": "0.28.2" }
}
